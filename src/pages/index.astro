---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import ProjectList from '../components/ProjectList.astro';
import SocialMediaLinks from '../components/SocialMediaLinks.astro';
import Footer from '../components/Footer.astro';
import Fediring from '../components/Fediring.astro';
---

<Layout title="detta.dev" description="Home of Punished Bernadetta">
    <div class="homepage">
        <header>
            <Logo />
            <h1>Detta.dev</h1>
            <p>Full-stack developer, modder</p>
            <SocialMediaLinks />
        </header>
        <main>
            <ProjectList />
            <p>...and more!</p>
        </main>
        <Footer>
            <Fediring />
            <div class="badge-collection">
                <img
                    class="badge pixelated"
                    src="/badges/no-ai.gif"
                    alt={`"No generative AI was used. Made with real fox paws." badge (made by me)`}
                    loading="lazy"
                />
                <a
                    rel="noopener"
                    target="_blank"
                    href="https://googleballs.com/"
                >
                    <img
                        class="badge pixelated"
                        src="/badges/google_balls.png"
                        alt="4 colored balls representing Google Balls website"
                        loading="lazy"
                    />
                </a>
                <img
                    class="badge pixelated"
                    src="/badges/miku_approved.gif"
                    alt={`"This site is Miku approved" badge"`}
                    loading="lazy"
                />
                <img
                    class="badge"
                    src="/badges/hatsune-miku-vocaloid.gif"
                    alt="Hatsune Miku badge"
                    loading="lazy"
                />
                <a
                    rel="noopener"
                    target="_blank"
                    href="https://www.youtube.com/playlist?list=OLAK5uy_mle9vZkH4IugHNriwVKAvQ73EU-Dl8tCw"
                >
                    <img
                        class="badge"
                        src="/badges/tohobossanova7.png"
                        alt="Toho Bossa Nova 7 album badge"
                        loading="lazy"
                    />
                </a>
            </div>
        </Footer>
    </div>
</Layout>

<style>
    .badge-collection {
        display: flex;
        flex-wrap: wrap;
        gap: 1ch;
        justify-content: center;
    }
    .badge {
        height: 31px;
    }
    .pixelated {
        image-rendering: pixelated;
    }
    .homepage {
        display: flex;
        justify-content: center;
        flex-direction: column;
        text-align: center;
    }
    header {
        h1 {
            font-size: 3rem;
            margin: 0;
        }

        p {
            font-size: 1rem;
            margin-bottom: 24px;
            margin-top: 0;
        }
        margin-bottom: 1em;
    }
</style>
